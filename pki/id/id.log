ykman piv keys generate \
  --algorithm ECCP384 \
  --pin-policy always \
  --touch-policy always \
  9c paul_macbookpro_pub.pem

ykman piv certificates request 9c paul_macbookpro_pub.pem paul_macbookpro.csr \
  -s "CN=Paul La Rocque,OU=Brown Rook,O=10134646 Manitoba Ltd,C=CA"
# -s "CN=Paul La Rocque,O=10134646 Manitoba Ltd. (Brown Rook),C=CA" 

p11tool --provider /opt/homebrew/lib/libykcs11.dylib --list-tokens

paul@m4pro id % export INT_CA_KEY_URI="$(                     
  p11tool --provider /opt/homebrew/lib/libykcs11.dylib \
    --login \
    --list-all \
    --only-urls \
  | grep -E 'id=%02.*type=private|type=private.*id=%02'
)"

export GNUTLS_PIN="INTERMEDIATEKEYPIN"    

### paul_macbookpro.tmpl 
cn = "Paul La Rocque"
organization = "10134646 Manitoba Ltd. (Brown Rook)"
country = "CA"
email = paul.larocque@brownrook.com

# Key Usage flags (RFC5280 digitalSignature)
signing_key

# Extended Key Usage flags
email_protection_key
code_signing_key

# Identifiers
subject_key_identifier = hash
authority_key_identifier = keyid,issuer


paul@m4pro id % /opt/homebrew/opt/gnutls/bin/gnutls-certtool \
  --generate-certificate \
  --hash SHA384 \
  --load-request paul_macbookpro.csr\
  --template paul_macbookpro.tmpl \
  --load-ca-certificate ../../intermediate/intermediate_ca.crt \
  --provider /opt/homebrew/lib/libykcs11.dylib \
  --load-ca-privkey "$INT_CA_KEY_URI" \
  --outfile paul_macbookpro.crt

cat paul_macbookpro.crt ../../intermediate/intermediate_ca.crt > paul_macbookpro_bundle.pem
ykman piv certificates import 9c paul_macbookpro_bundle.pem
ykman piv info

ykman piv keys export 9c paul_macbookpro_pub.pem
ykman piv certificates export 9c paul_macbookpro_export_cert_pub.pem
openssl x509 -in paul_macbookpro.crt -pubkey -noout \
| openssl pkey -pubin -outform der \
| openssl sha1
openssl x509 -in paul_macbookpro_export_cert_pub.pem -pubkey -noout \
| openssl pkey -pubin -outform der \
| openssl sha1
openssl pkey -pubin -in paul_macbookpro_export_pub.pem -outform der \
| openssl sha1





