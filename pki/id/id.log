paul@m4pro macbookpro % cat        intermediate-ca.cnf
[ ca ]
default_ca = CA_default

[ CA_default ]
# Minimal CA database files (needed by openssl ca)
dir            = ../../intermediate
database       = $dir/index.txt
new_certs_dir  = $dir/newcerts
serial         = $dir/serial

certificate    = $dir/intermediate_ca.crt
private_key    = pkcs11:model=YubiKey%20YK5;manufacturer=Yubico%20%28www.yubico.com%29;serial=14924286;token=YubiKey%20PIV%20%2314924286;id=%02;object=Private%20key%20for%20Digital%20Signature;type=private

default_md     = sha384
default_days   = 365
policy         = policy_any
copy_extensions = copy

[ policy_any ]
countryName             = supplied
organizationName        = supplied
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

paul@m4pro pkcs11-provider % cat /tmp/openssl-pkcs11.cnf
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
pkcs11  = pkcs11_sect

[default_sect]
activate = 1

[pkcs11_sect]
activate = 1
pkcs11-module-path = /opt/homebrew/lib/libykcs11.dylib

paul@m4pro pkcs11-provider % export OPENSSL_MODULES="/opt/homebrew/opt/openssl@3/lib/ossl-modules"
paul@m4pro pkcs11-provider % export OPENSSL_CONF="/Users/paul/brownrook-ca/id/openssl-pkcs11.cnf" 
paul@m4pro pkcs11-provider % openssl list -providers
Providers:
  default
    name: OpenSSL Default Provider
    version: 3.6.1
    status: active
  pkcs11
    name: PKCS#11 Provider
    version: 1.1
    status: active

#export PKCS11_PIN=842052
openssl ca \
  -provider pkcs11 -provider default \
  -config intermediate-ca.cnf \
  -extensions v3_user \
  -extfile brownrook-user-ext.cnf \
  -in paul_macbookpro.csr \
  -out paul_macbookpro.crt \
  -batch \
  -notext

# initialize serial database
mkdir -p newcerts
: > index.txt
echo 1000 > serial


