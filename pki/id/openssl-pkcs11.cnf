openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
pkcs11  = pkcs11_sect

[default_sect]
activate = 1

[pkcs11_sect]
activate = 1
module = /opt/homebrew/opt/openssl@3/lib/ossl-modules/pkcs11.dylib
pkcs11-module-path = /opt/homebrew/lib/opensc-pkcs11.so
