openssl genrsa -out brownrook_smime.key 3072
chmod 600 brownrook_smime.key


openssl req -new -key brownrook_smime.key -out brownrook_smime.csr \
  -subj "/CN=Paul La Rocque/OU=Brown Rook/O=10134646 Manitoba Ltd/L=Ile des Chenes/ST=MB/C=CA/emailAddress=paul.larocque@brownrook.com"

export INT_CA_KEY_URI="$(
  p11tool --provider /opt/homebrew/lib/opensc-pkcs11.so \
    --login --list-all --only-urls \
  | grep -E 'type=private' \
  | grep -E 'id=%02|;id=02' \
  | head -n 1
)"
echo "$INT_CA_KEY_URI"

export OPENSSL_MODULES="/opt/homebrew/opt/openssl@3/lib/ossl-modules"
export OPENSSL_CONF="/Users/paul/brownrook-ca/id/openssl-pkcs11.cnf" 
openssl list -providers

openssl ca \
  -config intermediate-ca.cnf \
  -extensions v3_user \
  -extfile brownrook-user-ext.cnf \
  -in brownrook_smime.csr  -out brownrook_smime.crt \
  -batch -notext

cat ../../intermediate/intermediate_ca.crt ../../root/root_ca.crt > chain.pem
openssl pkcs12 -export \
  -inkey brownrook_smime.key \
  -in brownrook_smime.crt  \
  -certfile chain.pem \
  -out brownrook_smime.p12

openssl pkcs12 -in brownrook_smime.p12 -nokeys -out chain.pem
awk 'BEGIN{c=0}/BEGIN CERT/{c++}{print > ("cert" c ".pem")}' chain.pem
openssl x509 -in cert1.pem -noout -subject -issuer
